{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thooton/wave/spec/package.schema.json",
  "title": "package.json: a Wave package, format version 1",
  "description": "See docs/source-format.md. Unknown fields are allowed and ignored. A reader lists a package with an unknown type as unavailable; this schema only describes the types version 1 installs.",
  "type": "object",
  "required": ["id", "type", "name", "summary", "version", "download"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])",
      "maxLength": 100,
      "description": "apk: the Android package name. module: the Magisk module id."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*(?![\\s\\S])",
      "description": "Dot-separated numbers, compared part by part."
    }
  },
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["apk", "module"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 30 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n]*(?![\\s\\S])" },
    "description": { "type": "string", "maxLength": 4000 },
    "author": { "type": "string", "maxLength": 60 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "license": { "type": "string", "maxLength": 40 },
    "version": { "$ref": "#/$defs/version" },
    "download": {
      "type": "object",
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" }
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "device": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "sdk": { "type": "integer", "minimum": 1 },
        "wave": { "type": "integer", "minimum": 1 },
        "firmware": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Build fingerprints tested on. Advisory only."
        }
      }
    },
    "depends": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/id" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "min": { "$ref": "#/$defs/version" }
            }
          }
        ]
      }
    },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "replaces": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "changes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["version", "text"],
        "properties": {
          "version": { "$ref": "#/$defs/version" },
          "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
