<?xml version="1.0" encoding="utf-8"?>
<!-- adb backup keeps Wave's data, except the sources: a private source's
     address carries its token (see core/sources), which must not leave the
     phone in a backup file. -->
<full-backup-content>
    <exclude domain="file" path="sources.json" />
    <exclude domain="file" path="sources" />
</full-backup-content>
