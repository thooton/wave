#!/system/bin/sh
# Stands in for magisk --install-module: what install_module leaves for an id.
case "$1" in
--install-module) id=wave_test_ok
  mkdir -p $WAVE_ADB/modules_update/$id $WAVE_ADB/modules/$id
  echo "id=$id" > $WAVE_ADB/modules_update/$id/module.prop
  touch $WAVE_ADB/modules/$id/update; rm -f $WAVE_ADB/modules/$id/disable $WAVE_ADB/modules/$id/remove
  echo "- Done" ;;
*) exit 1 ;;
esac
