#!/sbin/.magisk/busybox/busybox sh
# Pretend /sbin/magisk: -v, -V and --install-module as Magisk 24.0's
# (scripting.cpp install_module: util_functions.sh's install_module under
# Magisk's busybox). Only mounting partitions is skipped.
case "$1" in
    -v) echo 24.0:MAGISK ;;
    -V) echo 24000 ;;
    --path) echo /sbin ;;
    --install-module)
        export OUTFD=1 ZIPFILE="$(/sbin/.magisk/busybox/busybox realpath "$2")" ASH_STANDALONE=1
        exec /sbin/.magisk/busybox/busybox sh -c '
. /data/adb/magisk/util_functions.sh
mount_partitions() { :; }
install_module
exit 0' 2>/dev/null ;;
    *) echo "magisk stub: $*" >&2; exit 1 ;;
esac
