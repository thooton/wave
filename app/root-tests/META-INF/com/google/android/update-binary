#!/sbin/sh
# Magisk's standard module installer, so the Magisk app can install these
# zips by hand too. Wave itself uses `magisk --install-module`, which
# doesn't run this.
umask 022
ui_print() { echo "$1"; }
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || { ui_print "! Needs Magisk 20.4+"; exit 1; }
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && { ui_print "! Needs Magisk 20.4+"; exit 1; }
install_module
exit 0
