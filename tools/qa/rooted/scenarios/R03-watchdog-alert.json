{
  "rooted": true,
  "name": "The watchdog's Turned off alert, OK, Turn On, and Remove It, from the record it leaves (no reboot; the real boot is R04)",
  "steps": [
    {
      "name": "State the watchdog leaves after turning a mod off: the module's folder with a disable file, and a line in disabled",
      "do": "su",
      "cmd": "mkdir -p /data/adb/wave /data/adb/modules/wave_test_ok && printf 'id=wave_test_ok\\nname=Wave Test OK\\nversion=1.0\\nversionCode=1\\nauthor=Wave QA\\ndescription=State made by the QA suite\\n' > /data/adb/modules/wave_test_ok/module.prop && touch /data/adb/modules/wave_test_ok/disable && printf '%s\\twave_test_ok\\tboot-timeout\\n' $(date +%s) >> /data/adb/wave/disabled && ls /data/adb/modules/wave_test_ok",
      "expect": "disable"
    },
    {
      "name": "Give Wave root",
      "do": "pregrant"
    },
    {
      "name": "Wave Home",
      "action": "launch",
      "wait_ms": 3500
    },
    {
      "name": "Down to the Root row",
      "key": "DPAD_DOWN",
      "repeat": 2,
      "focus_on": "Root for System Mods"
    },
    {
      "name": "Open it",
      "key": "ENTER",
      "before_text": [
        "Root for System Mods"
      ],
      "wait_ms": 1000,
      "text_all": [
        "Check Again"
      ],
      "changed": true
    },
    {
      "name": "Check Again finds the grant; Wave then reads the watchdog's record and alerts",
      "key": "ENTER",
      "before_text": [
        "Check Again"
      ],
      "wait_ms": 3000,
      "text_all": [
        "Wave Test OK",
        "Turned off",
        "Wave turned it off, so the phone starts without it"
      ],
      "focus_on": "OK"
    },
    {
      "name": "Left reaches Remove It",
      "key": "DPAD_LEFT",
      "focus_on": "Remove It",
      "focus_moved": true
    },
    {
      "name": "Right back to OK",
      "key": "DPAD_RIGHT",
      "focus_on": "OK",
      "focus_moved": true
    },
    {
      "name": "OK dismisses it",
      "key": "ENTER",
      "before_text": [
        "Turned off"
      ],
      "wait_ms": 1200,
      "text_none": [
        "Wave turned it off"
      ],
      "changed": true
    },
    {
      "name": "The line moved to disabled.seen (so it asks only once)",
      "do": "su",
      "cmd": "cat /data/adb/wave/disabled.seen; echo ---; cat /data/adb/wave/disabled 2>&1",
      "expect": "wave_test_ok(.|\\n)*---"
    },
    {
      "name": "Installed",
      "key": "DPAD_RIGHT",
      "repeat": 2,
      "wait_ms": 1000,
      "text_all": [
        "Wave Test OK",
        "Turned off"
      ]
    },
    {
      "name": "Down to its row",
      "key": "DPAD_DOWN",
      "wait_ms": 500,
      "focus_on": "Wave Test OK"
    },
    {
      "name": "Its menu offers Turn On",
      "key": "MENU",
      "wait_ms": 700,
      "text_all": [
        "Details",
        "Turn On",
        "Remove"
      ],
      "text_none": [
        "Turn Off"
      ],
      "changed": true
    },
    {
      "name": "Down to Turn On",
      "key": "DPAD_DOWN",
      "repeat": 2,
      "focus_on": "Turn On"
    },
    {
      "name": "Turn On",
      "key": "ENTER",
      "before_text": [
        "Turn On"
      ],
      "wait_ms": 3000,
      "changed": true,
      "text_all": [
        "System mod, 1.0"
      ],
      "text_none": [
        "Turned off"
      ]
    },
    {
      "name": "Turn On clears the disable file and puts the module on trial for the next boot",
      "do": "su",
      "cmd": "ls /data/adb/modules/wave_test_ok; echo ---; cat /data/adb/wave/pending",
      "expect": "module.prop(.|\\n)*---(.|\\n)*wave_test_ok",
      "expect_not": "disable"
    },
    {
      "name": "A module that is on has no Turn Off in Wave (only the watchdog turns a mod off)",
      "key": "MENU",
      "wait_ms": 700,
      "text_all": [
        "Details",
        "Remove"
      ],
      "text_none": [
        "Turn On",
        "Turn Off"
      ],
      "changed": true
    },
    {
      "name": "Close the menu",
      "key": "BACK",
      "wait_ms": 500,
      "text_all": [
        "Wave Test OK"
      ],
      "changed": true
    },
    {
      "name": "The watchdog turns it off again (same record as a failed boot)",
      "do": "su",
      "cmd": "touch /data/adb/modules/wave_test_ok/disable && printf '%s\\twave_test_ok\\tboot-incomplete\\n' $(date +%s) >> /data/adb/wave/disabled && am force-stop com.wave.xp3; echo done",
      "expect": "done"
    },
    {
      "name": "Wave opens again",
      "action": "launch",
      "wait_ms": 4000,
      "text_all": [
        "Wave Test OK",
        "Turned off",
        "restarted before it finished starting"
      ],
      "focus_on": "OK"
    },
    {
      "name": "Left reaches Remove It",
      "key": "DPAD_LEFT",
      "focus_on": "Remove It",
      "focus_moved": true
    },
    {
      "name": "Remove It opens the confirmation",
      "key": "ENTER",
      "before_text": [
        "Remove It"
      ],
      "wait_ms": 2500,
      "text_all": [
        "Confirm",
        "Wave Test OK"
      ],
      "changed": true
    },
    {
      "name": "Confirm",
      "key": "ENTER",
      "before_text": [
        "Confirm"
      ],
      "rooted_confirm": true,
      "wait_ms": 6000,
      "text_all": [
        "Done"
      ],
      "changed": true
    },
    {
      "name": "Magisk is told to remove it at the next restart",
      "do": "su",
      "cmd": "ls /data/adb/modules/wave_test_ok",
      "expect": "remove"
    }
  ],
  "note": "The record is written by the harness exactly as the watchdog writes it; R04 makes the watchdog write it for real."
}
