{
  "rooted": true,
  "name": "Wave asks Magisk for root, the d-pad answers Grant, Wave says it has root",
  "steps": [
    {
      "name": "Before: Wave has no Magisk grant",
      "do": "su",
      "cmd": "magisk --sqlite \"SELECT uid FROM policies\"",
      "expect_not": "uid=1\\d{4}"
    },
    {
      "name": "Wave Home",
      "action": "launch",
      "wait_ms": 2500,
      "text_all": [
        "Featured",
        "Wave Test OK",
        "What is Wave"
      ]
    },
    {
      "name": "Down to the Root row",
      "key": "DPAD_DOWN",
      "repeat": 3,
      "focus_on": "Root for System Mods"
    },
    {
      "name": "Open it",
      "key": "ENTER",
      "before_text": [
        "Root for System Mods"
      ],
      "wait_ms": 1000,
      "text_all": [
        "Wave Needs Root for Mods",
        "Check Again"
      ],
      "changed": true
    },
    {
      "name": "Check Again raises the Magisk prompt",
      "key": "ENTER",
      "before_text": [
        "Check Again"
      ],
      "wait_ms": 700
    },
    {
      "name": "Answer Magisk's prompt with the d-pad",
      "do": "answer_prompt"
    },
    {
      "name": "Wave toasts \"Wave has root\" (in the capture; toasts are not in the accessibility tree, so the checks after it are the assertions)",
      "action": "capture",
      "wait_ms": 200
    },
    {
      "name": "Magisk now holds a grant for Wave (policy 2 = allow)",
      "do": "su",
      "cmd": "magisk --sqlite \"SELECT uid,policy FROM policies WHERE uid >= 10000\"",
      "expect": "policy=2"
    },
    {
      "name": "Home no longer asks for root",
      "key": "DPAD_DOWN",
      "repeat": 3,
      "wait_ms": 800,
      "text_none": [
        "Root for System Mods",
        "Wave Needs Root"
      ]
    },
    {
      "name": "Look further down Home for the Root state",
      "key": "DPAD_DOWN",
      "repeat": 3,
      "wait_ms": 600
    }
  ]
}
